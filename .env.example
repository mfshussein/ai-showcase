# Which model provider to use. "anthropic" (default) or "openai" for any OpenAI-compatible API.
LLM_PROVIDER=anthropic

# Anthropic (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# MODEL_MAIN=claude-opus-5-5
# MODEL_FAST=claude-sonnet-5-5

# OpenAI-compatible (when LLM_PROVIDER=openai). Examples:
#   Qwen on Alibaba Cloud Model Studio (Singapore): https://dashscope-intl.aliyuncs.com/compatible-mode/v1   MODEL_MAIN=qwen3.8-max  MODEL_FAST=qwen3.8-flash
#   DeepSeek:                                      https://api.deepseek.com                               MODEL_MAIN=deepseek-v4-pro  MODEL_FAST=deepseek-flash
#   Kimi (Moonshot):                               https://api.moonshot.ai/v1                             MODEL_MAIN=kimi-k3  MODEL_FAST=kimi-k2.6
#   OpenRouter (any model):                        https://openrouter.ai/api/v1                           MODEL_MAIN=qwen/qwen3.8-max-0902  MODEL_FAST=qwen/qwen3.8-flash
# LLM_BASE_URL=
# LLM_API_KEY=
# MODEL_MAIN=
# MODEL_FAST=
# Optional price overrides in USD per million tokens, "input,output", for the cost shown in the evidence drawer.
# LLM_PRICE_MAIN=2,6
# LLM_PRICE_FAST=0.14,0.42

# Access codes and cookie signing
VIEWER_PASSWORD=change-me
PRESENTER_PASSWORD=change-me-too
COOKIE_SECRET=generate-32-random-bytes
