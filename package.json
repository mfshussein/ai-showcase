{
  "name": "ai-showcase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "record": "node --env-file=.env.local --import tsx scripts/record.mts",
    "shot": "node --import tsx scripts/shot.mts",
    "images": "node --import tsx scripts/make-images.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "openai": "^7.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/diff": "^7.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
